{
  "name": "nextjs-starter-prismic-minimal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:next:dev\" \"npm:slicemachine\" --names \"next,slicemachine\" --prefix-colors blue,magenta",
    "next:dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint .",
    "slicemachine": "start-slicemachine",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "shop:migrate": "prisma migrate dev",
    "shop:deploy-migrations": "prisma migrate deploy",
    "shop:seed": "tsx prisma/seed.ts",
    "shop:staff": "tsx scripts/shop-staff.ts",
    "shop:migrate-music": "tsx scripts/migrate-music-licenses.ts",
    "shop:stripe": "sh -c 'set -a; [ -f .env ] && . ./.env; [ -f .env.local ] && . ./.env.local; STRIPE_API_KEY=$STRIPE_SECRET_KEY ${STRIPE_CLI:-$HOME/.local/bin/stripe} listen --forward-to localhost:3000/api/stripe/webhook'",
    "shop:reconcile-payments": "tsx --conditions=react-server scripts/reconcile-payments.ts",
    "stripe:listen": "set -a && . ./.env && set +a && ${STRIPE_CLI:-$HOME/.local/bin/stripe} listen --api-key $STRIPE_SECRET_KEY --forward-to localhost:3000/api/stripe/webhook --events payment_intent.succeeded,payment_intent.payment_failed,payment_intent.canceled,refund.created,refund.updated,refund.failed,charge.refunded"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.31.1",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prismicio/client": "^7.18.2",
    "@prismicio/next": "^2.2.4",
    "@prismicio/react": "^3.2.1",
    "@react-three/drei": "^10.5.1",
    "@react-three/fiber": "^9.2.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@vercel/blob": "^2.8.1",
    "clsx": "^2.1.0",
    "framer-motion": "^11.18.2",
    "hash-wasm": "^4.12.0",
    "hls.js": "^1.6.15",
    "next": "16.2.7",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.1.11",
    "three": "^0.178.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@slicemachine/adapter-next": "^0.3.96",
    "@types/node": "^22.13.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.6",
    "eslint": "^9.19.0",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.10.0",
    "slice-machine-ui": "^2.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
