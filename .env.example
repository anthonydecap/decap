# ─── DMI Music Shop ───────────────────────────────────────────────────────────
# Names only. Copy to .env.local and fill in. Never put server secrets in NEXT_PUBLIC_*.

# Database (PostgreSQL, used only by the shop; separate from any other DATABASE_URL)
SHOP_DATABASE_URL=
# Direct (non-pooled) URL used by Prisma migrations, e.g. Neon's DATABASE_URL_UNPOOLED
SHOP_DATABASE_URL_UNPOOLED=
# Optional: test database for `npm test` (must contain "test"; defaults to local decap_shop_test)
SHOP_TEST_DATABASE_URL=

# Auth0 (Regular Web Application, @auth0/nextjs-auth0 v4)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32+ random bytes, e.g. `openssl rand -hex 32`
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Stripe (TEST mode)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `npm run stripe:listen` locally, or the dashboard endpoint in deployed environments
STRIPE_WEBHOOK_SECRET=
# Live keys are refused unless this is "true"
SHOP_ALLOW_LIVE_STRIPE=

# Storage: "vercel-blob" (default) | "local" (dev only) | "memory" (tests)
SHOP_STORAGE_DRIVER=
# HMAC secret for upload tickets and local dev download links (`openssl rand -hex 32`)
SHOP_UPLOAD_TICKET_SECRET=
# Encrypts player activation keys at rest (AES-256-GCM). `openssl rand -hex 32`.
# Keep it out of logs and backups that staff can read; losing it makes stored keys
# unreadable, which is recoverable only by asking the EXE for the key again.
SHOP_ACTIVATION_KEY_SECRET=
# Signed admin upload URL lifetime in seconds, clamped to 300-900 (default 600)
SHOP_UPLOAD_URL_TTL_SECONDS=

# Vercel Blob. Simplest: ONE private store linked to the project (BLOB_STORE_ID + BLOB_READ_WRITE_TOKEN);
# masters/, deliveries/ and previews/ then share it and previews use signed URLs.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Optional: separate stores per role. Production: set *_STORE_ID and rely on Vercel OIDC.
# Local development against real Blob: use the per-store read-write tokens instead.
BLOB_MASTERS_STORE_ID=
BLOB_DELIVERIES_STORE_ID=
BLOB_PREVIEWS_STORE_ID=
BLOB_MASTERS_READ_WRITE_TOKEN=
BLOB_DELIVERIES_READ_WRITE_TOKEN=
BLOB_PREVIEWS_READ_WRITE_TOKEN=
# Public base URL of the previews store, e.g. https://<id>.public.blob.vercel-storage.com
BLOB_PREVIEWS_PUBLIC_BASE_URL=
# "public" or "private". Defaults to private unless a dedicated previews store is configured.
SHOP_PREVIEWS_ACCESS=

# Validation / policy
# Hex magic bytes of the proprietary DMI container, e.g. "44 4d 49" (enables DMI signature checks)
SHOP_DMI_MAGIC_HEX=
# Files above this size use the browser-computed SHA-256 (default 268435456 = 256 MB)
SHOP_SERVER_HASH_MAX_BYTES=
SHOP_REQUIRE_PREVIEW_TO_PUBLISH=true
# Defaults to true in production; requires the `amr: ["mfa"]` claim on staff sessions
SHOP_REQUIRE_STAFF_MFA=

# Legal documents shown at onboarding (bump a version to require re-acceptance)
SHOP_TERMS_VERSION=2026-10-01
SHOP_PRIVACY_VERSION=2026-10-01
SHOP_TERMS_URL=
SHOP_PRIVACY_URL=

# Seed: create an ADMIN StaffAccount for this Auth0 user_id
SHOP_SEED_ADMIN_SUB=

# Encoder worker (future player delivery; not used by the storefront)
DMI_ENCODER_WORKER_URL=
DMI_ENCODER_PROFILE_V1=

# Playwright end-to-end (Auth0 test tenant users)
E2E_BASE_URL=
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_NEW_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Email notifications (support replies, staff invitations). Without these, emails are only logged
# and invitation links are shown to the SUPER_ADMIN to share manually.
RESEND_API_KEY=
# e.g. "DMI Support <support@your-domain>" (domain must be verified with the provider)
SHOP_EMAIL_FROM=

# Website enquiry forms (/api/contact). The sender must be verified with Resend; falls back to SHOP_EMAIL_FROM.
# e.g. "Decap Herentals <website@decap.be>"
CONTACT_EMAIL_FROM=
# Where forms are delivered: general and organ enquiries, and Atelier Frank Decap.
CONTACT_TO_DECAP=
CONTACT_TO_FRANK=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Loads only after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=

# CRM: lifetime net spend (cents) for the "High value" customer view (default 50000 = EUR 500)
SHOP_CRM_HIGH_VALUE_CENTS=
