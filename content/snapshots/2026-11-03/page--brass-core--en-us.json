        "items": [],
        "primary": {
          "eyebrow": "Expression",
          "title": "Every dynamic, exactly as recorded",
          "body": [
            {
              "type": "paragraph",
              "text": "Because Brass Core works from the audio waveform itself, it follows the volume, articulation and expression of the recording note for note. Feed it a good trumpet recording and the audience hears a real instrument play it.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "It is an Orchestrionix instrument: no music library, no presets. You bring the performance.",
              "spans": []
            }
          ],
