      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "Can it recreate dynamics and expression?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. It works directly from the audio waveform, so volume, articulation and expression come through exactly as they are in the recording.",
                "spans": []
              }
            ]
          },
          {
            "question": "Do I need to modify my instrument?",
            "answer": [
              {
                "type": "paragraph",
                "text": "No. Brass Core is non-invasive: no drilling, no cutting, nothing permanent.",
                "spans": []
              }
            ]
          },
          {
            "question": "Can I use it live?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. It is used in shows, installations and demonstrations wherever a real brass sound is needed without a player.",
                "spans": []
              }
            ]
          },
          {
            "question": "How does it connect?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Feed it a line-level audio signal, ideally a high-quality brass recording, through an external amplifier. Brass Core does the rest.",
                "spans": []
              }
            ]
          },
          {
            "question": "How fast can I have one?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Brass Core is one of our few off-the-shelf products: when it is in stock, it ships straight away.",
                "spans": []
              }
            ]
          }
        ],
