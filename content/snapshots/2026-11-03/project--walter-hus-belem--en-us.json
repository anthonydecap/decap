        "primary": {
          "eyebrow": "The Mekanics",
          "title": "Accordion, cello and an orguedinateur",
          "body": [
            {
              "type": "paragraph",
              "text": "BELEM is accordion and cello. For The Mekanics, Walter Hus added his mechanical orchestra, which he calls the orguedinateur: an organ and a computer in one word. The result is an album that moves from film music to Balkan rhythms, baroque and jazz.",
              "spans": [
                {
                  "start": 34,
                  "end": 46,
                  "type": "em"
                },
                {
                  "start": 110,
                  "end": 123,
                  "type": "em"
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "The pipe units are built to travel, so the orchestra goes on tour with the musicians.",
              "spans": []
            }
          ],
