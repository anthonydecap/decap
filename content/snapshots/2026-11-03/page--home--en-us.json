        "primary": {
          "eyebrow": "Where they play",
          "title": "In living rooms, bars and dance halls",
          "intro": [
            {
              "type": "paragraph",
              "text": "Most Decap organs and instruments belong to private owners. They play at home, in a café or bar, in a dance hall, all over the world.",
              "spans": []
            }
          ],
