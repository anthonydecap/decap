          "title": "Privacy policy for decap.be",
          "intro": [
            {
              "type": "paragraph",
              "text": "This notice explains what personal data we process when you use this website, why, and what rights you have. We keep it short and only collect what we need to answer you.",
              "spans": []
            }
          ],
          "primary_cta_label": null,
