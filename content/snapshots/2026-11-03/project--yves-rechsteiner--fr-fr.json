      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "quote": [
            {
              "type": "paragraph",
              "text": "Tous reconnaissent le haut niveau de qualité, de performance et de réponse de la smART valve de Tony Decap.",
              "spans": []
            }
          ],
          "name": "Yves Rechsteiner",
          "role": "À propos des facteurs d'orgues qui ont vu L'Explorateur",
          "image": {},
          "tone": "Default"
        },
        "id": "site_quote$cebe9834-fed2-4825-a01f-090d70a587e8",
        "slice_type": "site_quote",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "La suite",
          "title": "Un instrument qui continue de grandir",
          "body": [
            {
              "type": "paragraph",
              "text": "L'Explorateur n'est pas terminé, et c'est bien là l'idée.",
              "spans": []
            },
            {
              "type": "list-item",
              "text": "Clavier Osmose : la pression du vent suit la touche, et l'organiste joue avec une technique de piano ou de clavicorde.",
              "spans": [
                {
                  "start": 0,
                  "end": 16,
                  "type": "strong"
                }
              ]
            },
            {
              "type": "list-item",
              "text": "Logiciel de console : un outil pour programmer l'attaque, le développement et le vibrato de chaque son, inspiré des enveloppes ADSR.",
              "spans": [
                {
                  "start": 0,
                  "end": 21,
                  "type": "strong"
                }
              ]
            },
            {
              "type": "list-item",
              "text": "Tuyaux polyphones pour la basse du Principal et du Salicional : plusieurs notes avec un seul tuyau.",
              "spans": [
                {
                  "start": 0,
                  "end": 17,
                  "type": "strong"
                }
              ]
            },
            {
              "type": "list-item",
              "text": "Nouvelles boîtes expressives conçues par Tony Decap, pour les nuances les plus douces.",
              "spans": [
                {
                  "start": 0,
                  "end": 28,
                  "type": "strong"
                }
              ]
            },
            {
              "type": "list-item",
              "text": "Un Ophicléide 16′ plus léger, et un jeu à anches libres provenant d'un orgue expressif Muller de 1830.",
              "spans": [
                {
                  "start": 0,
                  "end": 28,
                  "type": "strong"
                },
                {
                  "start": 71,
                  "end": 86,
                  "type": "em"
                }
              ]
            }
          ],
          "image": {},
          "video": {
            "link_type": "Media"
          },
