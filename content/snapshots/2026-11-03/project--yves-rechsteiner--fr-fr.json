          },
          {
            "year": "2021",
            "title": "Début de la construction",
            "body": [
              {
                "type": "paragraph",
                "text": "Pendant la construction, Decap propose une nouveauté : régler le vent non plus par sommier, mais par tuyau.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null,
            "highlight": false
