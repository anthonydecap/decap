          {
            "year": "2023",
            "title": "Premiers concerts",
            "body": [
              {
                "type": "paragraph",
                "text": "Après deux ans de travail et de recherche, L'Explorateur joue avec la première génération de soupapes. Les concerts commencent.",
                "spans": []
              }
            ],
            "image": {},
