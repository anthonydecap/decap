        "primary": {
          "title": "Real reeds. Real accordion sound.",
          "body": [
            {
              "type": "paragraph",
              "text": "This is not a sampled accordion. Air flows through real reeds inside an acoustic instrument. Electronic control operates the keys and regulates the airflow normally created by the player, preserving the natural tone and mechanical character of the accordion.",
              "spans": [],
              "direction": "ltr"
            }
          ],
