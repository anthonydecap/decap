      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "What is an automatic accordion?",
            "answer": [
              {
                "type": "paragraph",
                "text": "It is a real acoustic accordion whose keys, registers and airflow are operated electronically. It can perform MIDI arrangements without a human player.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "question": "Does it use sampled accordion sounds?",
            "answer": [
              {
                "type": "paragraph",
                "text": "No. The main accordion sound is produced by air moving across real reeds. The built-in sound module and speakers can add electronic accompaniment.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "question": "Can it be played live?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. Connect a MIDI keyboard or controller through MIDI In and play the accordion in real time. MIDI Out and Thru allow integration with other instruments.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          }
        ],
