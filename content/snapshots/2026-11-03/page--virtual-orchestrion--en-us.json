      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "One ensemble",
          "title": "Every instrument plays its own part",
          "body": [
            {
              "type": "paragraph",
              "text": "Connect an Accordion Pedestal, a Percussion Unit, Pipes or a complete organ, and Virtual Orchestrion drives them together from one arrangement. It also drives QRS pianos, so a player piano can join the band.",
              "spans": [
                {
                  "start": 11,
                  "end": 29,
                  "type": "hyperlink",
                  "data": {
                    "link_type": "Web",
                    "url": "/accordion"
                  }
                },
                {
                  "start": 33,
                  "end": 48,
                  "type": "hyperlink",
                  "data": {
                    "link_type": "Web",
                    "url": "/percussion-unit"
                  }
                },
                {
                  "start": 50,
                  "end": 55,
                  "type": "hyperlink",
                  "data": {
                    "link_type": "Web",
                    "url": "/pipes"
                  }
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Whatever you have not connected can still sound: the player hosts up to 8 VSTi and 8 DXi virtual instruments for the remaining parts.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 497,
              "height": 312
            },
            "alt": "Virtual Orchestrion on a laptop",
            "copyright": null,
            "url": "https://images.prismic.io/decap/VGZHmKnvMUT6nZvo_VirtualPlayerLaptop1-1.png?auto=format,compress",
            "id": "VGZHmKnvMUT6nZvo",
