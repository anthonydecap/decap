      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "For arrangers",
          "title": "Selling your arrangements: coming soon",
          "body": [
            {
              "type": "paragraph",
              "text": "A marketplace where arrangers sell their work to Decap owners is coming soon. Each arrangement will be copy-protected and formatted to use everything the player can do, on real instruments as well as virtual ones.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "Arranging for orchestrions or organs? Register your interest and we let you know when it opens.",
              "spans": []
            }
          ],
          "image": {},
          "video": {
            "link_type": "Media"
          },
          "image_brief": "Arranger at a desk with a DAW on screen and a MIDI keyboard, 4:3",
          "media_side": "Image right",
          "aspect": "Landscape 4:3",
          "cta_label": "Register your interest",
          "cta_link": {
            "link_type": "Web",
            "key": "0f9612cd-f970-4b6c-9226-3562d58d74fd",
            "url": "/contact"
          },
          "tone": "Default"
        },
        "id": "site_text_media$cf0e4607-6c92-4def-a4ac-2565bb633cbf",
        "slice_type": "site_text_media",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "Do I need a Decap instrument to use it?",
            "answer": [
              {
                "type": "paragraph",
                "text": "No. With virtual instruments loaded, Virtual Orchestrion plays orchestrion music on your computer. Connect real instruments and they take over their parts.",
                "spans": []
              }
            ]
          },
          {
            "question": "Which instruments can it drive?",
            "answer": [
              {
                "type": "paragraph",
                "text": "All Decap organs and self-playing instruments, and QRS pianos. See the instruments.",
                "spans": [
                  {
                    "start": 71,
                    "end": 82,
                    "type": "hyperlink",
                    "data": {
                      "link_type": "Web",
                      "url": "/instruments"
                    }
                  }
                ]
              }
            ]
          },
          {
            "question": "How does it add ranks my organ does not have?",
            "answer": [
              {
                "type": "paragraph",
                "text": "When an arrangement uses a rank that is not in your organ, the player plays it with samples we recorded in our workshop. Your organ plays its own pipes; the missing ranks sound through speakers.",
                "spans": []
              }
            ]
          },
          {
            "question": "Is it included with a new organ?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. Every new Decap organ comes with the Virtual Orchestrion player, and the Bellow Organ has it built in.",
                "spans": [
                  {
                    "start": 78,
                    "end": 90,
                    "type": "hyperlink",
                    "data": {
                      "link_type": "Web",
                      "url": "/bellow-organ"
                    }
                  }
                ]
              }
            ]
          },
          {
            "question": "Where do I buy it?",
            "answer": [
              {
                "type": "paragraph",
                "text": "In the Decap shop, where you buy and download it. With a new Decap organ it is included.",
                "spans": [
                  {
                    "start": 7,
                    "end": 17,
                    "type": "hyperlink",
                    "data": {
                      "link_type": "Web",
                      "url": "/software/virtual-orchestrion"
                    }
                  }
                ]
              }
            ]
          }
        ],
