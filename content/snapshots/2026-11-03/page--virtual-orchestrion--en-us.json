      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "title": "Install the player",
            "body": [
              {
                "type": "paragraph",
                "text": "Buy Virtual Orchestrion in the shop, download it and install it on your computer.",
                "spans": [
                  {
                    "start": 31,
                    "end": 35,
                    "type": "hyperlink",
                    "data": {
                      "link_type": "Web",
                      "url": "/software/virtual-orchestrion"
                    }
                  }
                ]
              }
            ],
            "image": {},
            "image_brief": null
          },
          {
            "title": "Connect your instruments",
            "body": [
              {
                "type": "paragraph",
                "text": "Connect your Decap instruments or QRS piano over MIDI. Parts without an instrument go to the virtual instruments you load.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null
          },
          {
            "title": "Choose your music",
            "body": [
              {
                "type": "paragraph",
                "text": "Play your own MIDI, audio and video files. Copy-protected arrangements in our shop are coming soon.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null
          },
          {
            "title": "Press play",
            "body": [
              {
                "type": "paragraph",
                "text": "Every instrument plays its part. Follow along in the animated orchestrion view or the book view.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null
          }
        ],
