        "primary": {
          "layout": "Split",
          "eyebrow": "Virtual Orchestrion",
          "title": "Virtual Orchestrion: one player for your whole orchestrion",
          "intro": [
            {
              "type": "paragraph",
              "text": "Virtual Orchestrion plays MIDI, audio and video and sends every instrument its part: Decap organs and self-playing instruments, and QRS pianos. On screen you follow the music as an animated orchestrion or as a scrolling book.",
              "spans": []
            }
          ],
          "primary_cta_label": "Get it in the shop",
          "primary_cta_link": {
            "link_type": "Web",
            "key": "bd33bb6d-8778-4414-859f-7eef3340ca9f",
            "url": "/software/virtual-orchestrion"
          },
          "secondary_cta_label": "Self-playing instruments",
          "secondary_cta_link": {
            "link_type": "Web",
            "key": "aea1b23b-66d7-429e-b54e-d4a3387c1542",
            "url": "/instruments"
          },
          "note": "Included with every new Decap organ.",
          "image": {
