      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "Keys are no limit",
          "title": "A smaller organ that plays larger scales",
          "body": [
            {
              "type": "paragraph",
              "text": "When an arrangement calls for ranks your organ does not have, Virtual Orchestrion adds them virtually, with samples we recorded in our own workshop. A 105-key organ plays 121-key music.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "So you choose the instrument that fits your room and budget, and still play the full repertoire.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 644,
              "height": 322
            },
            "alt": "Virtual Orchestrion on two screens",
            "copyright": null,
            "url": "https://images.prismic.io/decap/5KDblOy3MRiPEXhf_Virtual-Organ-5-1.png?auto=format,compress",
            "id": "5KDblOy3MRiPEXhf",
