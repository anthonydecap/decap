      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "Un seul ensemble",
          "title": "Chaque instrument joue sa propre partie",
          "body": [
            {
              "type": "paragraph",
              "text": "Connectez un Accordion Pedestal, une Percussion Unit, des Pipes ou un orgue complet, et Virtual Orchestrion les pilote ensemble à partir d'un seul arrangement. Il pilote aussi les pianos QRS : un piano automatique peut rejoindre l'orchestre.",
              "spans": [
                {
                  "start": 13,
                  "end": 31,
                  "type": "hyperlink",
                  "data": {
                    "link_type": "Web",
                    "url": "/accordion"
                  }
                },
                {
                  "start": 37,
                  "end": 52,
                  "type": "hyperlink",
                  "data": {
                    "link_type": "Web",
                    "url": "/percussion-unit"
                  }
                },
                {
                  "start": 58,
                  "end": 63,
                  "type": "hyperlink",
                  "data": {
                    "link_type": "Web",
                    "url": "/pipes"
                  }
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Ce que vous n'avez pas connecté peut quand même sonner : le lecteur accueille jusqu'à 8 instruments virtuels VSTi et 8 DXi pour les parties restantes.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 497,
              "height": 312
            },
            "alt": "Virtual Orchestrion on a laptop",
            "copyright": null,
            "url": "https://images.prismic.io/decap/VGZHmKnvMUT6nZvo_VirtualPlayerLaptop1-1.png?auto=format,compress",
            "id": "VGZHmKnvMUT6nZvo",
