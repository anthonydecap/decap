      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "Le nombre de touches n'est pas une limite",
          "title": "Un orgue plus petit qui joue des échelles plus grandes",
          "body": [
            {
              "type": "paragraph",
              "text": "Quand un arrangement demande des jeux que votre orgue n'a pas, Virtual Orchestrion les ajoute virtuellement, avec des échantillons enregistrés dans notre propre atelier. Un orgue 105 touches joue la musique 121 touches.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "Vous choisissez donc l'instrument qui convient à votre salle et à votre budget, et vous jouez tout de même tout le répertoire.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
