        "primary": {
          "layout": "Split",
          "eyebrow": "Virtual Orchestrion",
          "title": "Virtual Orchestrion : un seul lecteur pour tout votre orchestrion",
          "intro": [
            {
              "type": "paragraph",
              "text": "Virtual Orchestrion lit le MIDI, l'audio et la vidéo, et envoie à chaque instrument sa partie : orgues et instruments automatiques Decap, et pianos QRS. À l'écran, vous suivez la musique sous forme d'orchestrion animé ou de carton qui défile.",
              "spans": []
            }
          ],
          "primary_cta_label": "L'obtenir dans la boutique",
          "primary_cta_link": {
            "link_type": "Web",
            "key": "cc52c379-9775-4e5c-8dcb-132c5659fc39",
            "url": "/software/virtual-orchestrion"
          },
          "secondary_cta_label": "Instruments automatiques",
          "secondary_cta_link": {
            "link_type": "Web",
            "key": "58f2477d-ed18-4ee7-859d-6d0a39fd5be8",
            "url": "/instruments"
          },
          "note": "Inclus avec chaque nouvel orgue Decap.",
