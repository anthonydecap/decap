      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "title": "Installer le lecteur",
            "body": [
              {
                "type": "paragraph",
                "text": "Achetez Virtual Orchestrion dans la boutique, téléchargez-le et installez-le sur votre ordinateur.",
                "spans": [
                  {
                    "start": 36,
                    "end": 44,
                    "type": "hyperlink",
                    "data": {
                      "link_type": "Web",
                      "url": "/software/virtual-orchestrion"
                    }
                  }
                ]
              }
            ],
            "image": {},
            "image_brief": null
          },
          {
            "title": "Connecter vos instruments",
            "body": [
              {
                "type": "paragraph",
                "text": "Connectez vos instruments Decap ou votre piano QRS en MIDI. Les parties sans instrument vont vers les instruments virtuels que vous chargez.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null
          },
          {
            "title": "Choisir votre musique",
            "body": [
              {
                "type": "paragraph",
                "text": "Jouez vos propres fichiers MIDI, audio et vidéo. Des arrangements protégés contre la copie seront bientôt disponibles dans notre boutique.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null
          },
          {
            "title": "Appuyer sur lecture",
            "body": [
              {
                "type": "paragraph",
                "text": "Chaque instrument joue sa partie. Suivez dans la vue orchestrion animé ou dans la vue carton.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null
          }
        ],
