        "primary": {
          "title": "More than a drum kit.",
          "body": [
            {
              "type": "paragraph",
              "text": "A percussion unit can combine bass drum, snare, toms and cymbals with tambourine, claves, woodblock, cowbell, shaker and other acoustic percussion. The instrument selection is adapted to the music and the available space.",
              "spans": [],
              "direction": "ltr"
            }
          ],
          "media_type": "image",
