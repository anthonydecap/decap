      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "Which percussion instruments can be automated?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Drums, cymbals, tambourines, claves, woodblocks, cowbells, shakers and many other acoustic percussion instruments can be considered. The mechanics are designed around the required instruments and playing actions.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "question": "Can it be built into an organ façade?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. The percussion can be integrated into a traditional organ or orchestrion façade, including its mechanics, cabling and visual presentation.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "question": "Can the system be transportable?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. It can be built into a movable frame, touring rack or flight case. Other custom formats are possible when the installation requires a different layout.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          }
