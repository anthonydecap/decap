          {
            "item_title": "Individual actions",
            "item_description": [
              {
                "type": "paragraph",
                "text": "Each stick, beater and percussion action is controlled independently.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "image": {}
          },
          {
            "item_title": "Velocity-sensitive",
            "item_description": [
              {
                "type": "paragraph",
                "text": "MIDI velocity determines the force of the strike, from a light touch to a strong accent.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "image": {}
          },
          {
            "item_title": "Fast repetition",
            "item_description": [
              {
                "type": "paragraph",
                "text": "A 70 ms repeat time supports up to 14 strikes per second across the available velocity range.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "image": {}
          },
          {
            "item_title": "General MIDI",
            "item_description": [
              {
                "type": "paragraph",
