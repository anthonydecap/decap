      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "title": "Built into an organ façade",
            "description": [
              {
                "type": "paragraph",
                "text": "Integrate the complete percussion section into a traditional organ or orchestrion façade. Instruments, mechanics, lighting and cabling become part of one permanent installation.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "image": {}
          },
          {
            "title": "Built to travel",
            "description": [
              {
                "type": "paragraph",
                "text": "Mount the system in a transportable frame or flight case for touring, demonstrations and temporary installations. The layout can be designed for protection, access and fast setup.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "image": {}
          }
        ],
        "primary": {
          "footnote": "The system is not tied to one cabinet or format.",
          "background_color": null
