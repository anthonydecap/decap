        "primary": {
          "layout": "Split",
          "eyebrow": "MIDIMapper, for arrangers",
          "title": "Hear your organ arrangement with real organ samples",
          "intro": [
            {
              "type": "paragraph",
              "text": "Arranging for a street organ or pipe organ usually means writing blind until the music reaches the instrument. MIDIMapper takes the MIDI from your arranging software, routes it through your own maps and plays it with real organ samples. What you hear while arranging is much closer to what the organ will play.",
              "spans": []
            }
          ],
          "primary_cta_label": "Get the free trial in the shop",
          "primary_cta_link": {
            "link_type": "Web",
            "key": "f906ba3e-bbf6-4624-ac6d-4dcb7c800cae",
            "url": "/software/midi-mapper"
          },
