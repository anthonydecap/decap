      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "What it does",
          "title": "MIDI routing and organ playback in one program",
          "body": [
            {
              "type": "paragraph",
              "text": "MIDIMapper reads a MIDI input and sends each note to one or more outputs, following maps you define. A map can stack up to 12 layers, so you hear registrations in context: a Jazz Flute with and without tremolo, or a woodblock added on a note.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "Because the sound comes from real organ samples instead of General MIDI sounds, you judge balance and registration while you arrange, not after the book is cut.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 497,
              "height": 312
            },
            "alt": "MIDIMapper map editor",
            "copyright": null,
            "url": "https://images.prismic.io/decap/CH5CnU7qUNtGlP5__MidiMapperLaptop1-1.png?auto=format,compress",
            "id": "CH5CnU7qUNtGlP5_",
            "edit": {
              "x": 0,
              "y": 0,
              "zoom": 1,
              "background": "transparent"
            }
          },
