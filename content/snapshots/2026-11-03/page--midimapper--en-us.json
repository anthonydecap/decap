      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "title": "Connect your DAW",
            "body": [
              {
                "type": "paragraph",
                "text": "Send MIDI from your arranging software through a virtual MIDI cable such as loopMIDI, and pick the outputs. MIDIMapper stores this set-up for next time.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null
          },
          {
            "title": "Build your map",
            "body": [
              {
                "type": "paragraph",
                "text": "In the built-in MapCreator, assign incoming notes to output channels and registrations. Refine the map as you go.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null
          },
          {
            "title": "Listen and adjust",
            "body": [
              {
                "type": "paragraph",
                "text": "Play the arrangement through the organ samples. Correct note lengths in milliseconds to match the book and the organ's response.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null
          },
          {
            "title": "Record and share",
            "body": [
              {
                "type": "paragraph",
                "text": "Record the output and export it as a WAV file to review or share.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null
          }
        ],
