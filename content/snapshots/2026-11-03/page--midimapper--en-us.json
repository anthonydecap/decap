      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "Who is MIDIMapper for?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Arrangers who write for street organs or pipe organs and want to hear registrations while they work.",
                "spans": []
              }
            ]
          },
          {
            "question": "Does it work with my DAW?",
            "answer": [
              {
                "type": "paragraph",
                "text": "It works with any software that sends MIDI. Route the MIDI to MIDIMapper through a virtual MIDI cable such as loopMIDI.",
                "spans": []
              }
            ]
          },
          {
            "question": "Can I use my own samples?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. MIDIMapper supports custom samples, for example percussion or glockenspiel to complete an organ's sound.",
                "spans": []
              }
            ]
          },
          {
            "question": "Why adjust note lengths?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Mapper timing, book note lengths and the real organ's response differ. A global note length in milliseconds lets you compensate, and the drum delay switch matches book or arrangement timing.",
                "spans": []
              }
            ]
          },
          {
            "question": "How do I buy the full licence?",
            "answer": [
              {
                "type": "paragraph",
                "text": "In the shop: € 150 excl. VAT. The free trial is there too, so you can try MIDIMapper with your own arrangements first.",
                "spans": [
