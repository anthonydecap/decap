      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "Peut-il restituer les nuances et l'expression ?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Oui. Il travaille directement à partir de la forme d'onde audio : le volume, l'articulation et l'expression passent exactement comme dans l'enregistrement.",
                "spans": []
              }
            ]
          },
          {
            "question": "Dois-je modifier mon instrument ?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Non. Brass Core est non invasif : pas de perçage, pas de découpe, rien de définitif.",
                "spans": []
              }
            ]
          },
          {
            "question": "Puis-je l'utiliser en direct ?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Oui. Il sert dans des spectacles, des installations et des démonstrations, partout où il faut un vrai son de cuivre sans musicien.",
                "spans": []
              }
            ]
          },
          {
            "question": "Comment se branche-t-il ?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Envoyez-lui un signal audio niveau ligne, idéalement un enregistrement de cuivres de haute qualité, via un amplificateur externe. Brass Core fait le reste.",
                "spans": []
              }
            ]
          },
          {
            "question": "En combien de temps puis-je en avoir un ?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Brass Core est l'un de nos rares produits disponibles sur étagère : s'il est en stock, il est expédié immédiatement.",
                "spans": []
              }
            ]
          }
        ],
