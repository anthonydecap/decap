      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "How fast can you deliver?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Within a few days to a week, depending on the ranks you order. We confirm the date with the quote.",
                "spans": []
              }
            ]
          },
          {
            "question": "Do you sell single pipes?",
            "answer": [
              {
                "type": "paragraph",
                "text": "No. We make pipes as complete ranks, so every pipe in the rank is cut, voiced and matched with the next.",
                "spans": []
              }
            ]
          },
          {
            "question": "Can I send my own measurements?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. Send inside width and depth, length, mouth dimensions and wind pressure, or a drawing or sample pipe, and we make the rank to match.",
                "spans": []
              }
            ]
          },
          {
            "question": "Voiced or unvoiced?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Both. Our voicers can voice the pipes to your wind pressure, or you receive them ready to voice yourself.",
                "spans": []
              }
            ]
          },
          {
            "question": "Can you also make the wind chests?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. Order pipes and chests together, and add MIDI conversion or smARTvalve if you want the organ to play from MIDI.",
                "spans": []
              }
            ]
          },
          {
            "question": "Do you ship outside Belgium?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes, we ship worldwide. Shipping is part of your quote.",
                "spans": []
              }
            ]
          }
        ],
