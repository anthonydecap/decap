      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "point": "5-axis CNC, G-code from our own PipeCreator software"
          },
          {
            "point": "Ready in a few days to a week, depending on the ranks"
          },
          {
            "point": "Voiced by our voicers, or delivered for you to voice"
          }
        ],
        "primary": {
          "eyebrow": "How we make them",
          "title": "A process we developed ourselves",
          "body": [
            {
              "type": "paragraph",
              "text": "Since 2016 we mill our organ pipes on a 5-axis CNC. The G-code comes from PipeCreator, software we wrote in-house. No other company makes organ pipes this way. The machine cuts each part to exact dimensions and angles, so every pipe in a rank matches the next.",
              "spans": [
                {
                  "start": 74,
                  "end": 85,
                  "type": "strong"
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "After cutting and gluing, the pipe is ready for voicing and finishing. Our voicers can do that for you, or you take over at the stage you prefer.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 1448,
              "height": 1086
            },
            "alt": null,
            "copyright": null,
            "url": "https://images.prismic.io/decap/KSNKAS5nwlUB_t5s_Untitleddesign-13-.png?auto=format,compress",
            "id": "KSNKAS5nwlUB_t5s",
            "edit": {
              "x": 0,
              "y": 0,
              "zoom": 1,
              "background": "transparent"
            }
          },
          "video": {
