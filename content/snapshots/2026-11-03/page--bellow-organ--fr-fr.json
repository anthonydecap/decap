        "primary": {
          "layout": "Split",
          "eyebrow": "Bellow Organ",
          "title": "Un orgue à manivelle avec toutes les notes de la gamme",
          "intro": [
            {
              "type": "paragraph",
              "text": "Notre Bellow Organ est un orgue de rue à manivelle pour les musiciens de rue, les collectionneurs et tous ceux qui veulent jouer en plein air. Il est 100 % chromatique, joue depuis un lecteur Virtual Orchestrion intégré et est livré en kit ou entièrement monté. Il peut fonctionner sur batterie : il joue partout où vous l'emmenez.",
              "spans": []
            }
          ],
          "primary_cta_label": "Demander un devis",
          "primary_cta_link": {
            "link_type": "Web",
            "key": "d95e36a4-d5ea-475b-a93a-394cf7982ac6",
            "url": "/contact"
          },
          "secondary_cta_label": "Tous les instruments",
          "secondary_cta_link": {
            "link_type": "Web",
