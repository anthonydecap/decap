      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "Which mallet instruments can be automated?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Xylophones, metallophones, glockenspiels, marimbas and other instruments with individually playable bars can be considered. The final system is adapted to the instrument’s size, range and construction.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "question": "Is the sound sampled?",
            "answer": [
              {
                "type": "paragraph",
                "text": "No. Real hammers strike the instrument’s own bars. The bars and resonators produce the acoustic sound.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "question": "Does it respond to playing velocity?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. The controller converts MIDI velocity into a controlled hammer strike, allowing notes to be played softly or with greater force.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          }
        ],
