        "primary": {
          "eyebrow": "Brass Core",
          "title": "Live brass, played from an audio signal",
          "body": [
            {
              "type": "paragraph",
              "text": "Brass Core puts a real trumpet or trombone on stage and plays it from your own audio or MIDI. A voice-coil motor in a pressure chamber replaces the player's lips, and the instrument's own resonance shapes the tone. No drilling, no changes to the instrument.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "Circus Ronaldo uses it for its automated brass section.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 720,
              "height": 688
