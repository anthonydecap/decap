      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "quote": [
            {
              "type": "paragraph",
              "text": "The Brass Core has become the beating heart of our automated brass section. We didn't want to just play brass music through the PA - we wanted the audience to feel it, like a real band was right there on stage.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "People often ask us where the brass band is hiding - that's how convincing it is. It's not just sound. It's presence.",
              "spans": []
            }
          ],
