      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "Is this a barrel organ or a street organ?",
            "answer": [
              {
                "type": "paragraph",
                "text": "It is a hand-turned street organ: turning the wheel works the bellows. The music comes from the built-in Virtual Orchestrion player rather than a pinned barrel.",
                "spans": []
              }
            ]
          },
          {
            "question": "Why does 100% chromatic matter?",
            "answer": [
              {
                "type": "paragraph",
                "text": "With every note present you can transpose a song to any key within the range, and arrangements do not have to skip notes. Organs with gaps in the scale force the arranger to rewrite.",
                "spans": []
              }
            ]
          },
          {
            "question": "Can I assemble it myself?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. It is available as a kit for the handy builder, or pre-assembled and ready to play.",
                "spans": []
              }
            ]
          },
          {
            "question": "Can I add pipes later?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. Start with a few ranks and add extra stops when you are ready.",
                "spans": []
              }
            ]
          },
          {
            "question": "Does it work with other Decap instruments?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes. Over MIDI it can drive other Decap instruments as master, or follow them as slave. See the self-playing instruments.",
                "spans": [
                  {
                    "start": 96,
                    "end": 120,
                    "type": "hyperlink",
                    "data": {
                      "link_type": "Web",
                      "url": "/instruments"
                    }
                  }
                ]
              }
            ]
          }
        ],
