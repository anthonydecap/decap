        "primary": {
          "eyebrow": "Frame and panels",
          "title": "An aluminium frame with panels you can change in minutes",
          "body": [
            {
              "type": "paragraph",
              "text": "The organ is built on an aluminium frame. The top, front, side and back panels mount onto it and come off again in minutes.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "Choose high-gloss wood veneer, or blank pre-cut panels to paint and decorate yourself. Blank panels cost little, so you can keep a set for every occasion.",
              "spans": []
            }
          ],
