        "primary": {
          "layout": "Split",
          "eyebrow": "Bellow Organ",
          "title": "A hand-turned organ with every note of the scale",
          "intro": [
            {
              "type": "paragraph",
              "text": "Our Bellow Organ is a hand-turned street organ for buskers, collectors and anyone who wants to play outdoors. It is 100% chromatic, plays from a built-in Virtual Orchestrion player and comes as a kit or fully assembled. It can run on battery, so it plays wherever you take it.",
              "spans": []
            }
          ],
          "primary_cta_label": "Request a quote",
