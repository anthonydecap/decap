      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "Brass Core",
          "title": "Des cuivres en direct, joués à partir d'un signal audio",
          "body": [
            {
              "type": "paragraph",
              "text": "Brass Core met une vraie trompette ou un vrai trombone sur scène et le fait jouer à partir de votre propre audio ou MIDI. Un moteur à bobine mobile dans une chambre de pression remplace les lèvres du musicien, et la résonance propre de l'instrument façonne le timbre. Sans perçage, sans modification de l'instrument.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "Le Circus Ronaldo l'utilise pour sa section de cuivres automatisée.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 720,
              "height": 688
            },
            "alt": "Brass Core on a trumpet",
            "copyright": null,
            "url": "https://images.prismic.io/decap/aIu9zKTt2nPbZn2g_s.png?auto=format,compress",
