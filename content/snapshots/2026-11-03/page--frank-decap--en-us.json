      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "MIDI conversion",
          "title": "Book and MIDI in one organ",
          "body": [
            {
              "type": "paragraph",
              "text": "Frank installs the Decap MIDI conversion units made in Herentals. The units sit between the key frame and the main chest, so the book or roll keeps working as before, and book and MIDI can even play at the same time.",
              "spans": [
                {
                  "start": 19,
                  "end": 46,
                  "type": "hyperlink",
                  "data": {
                    "link_type": "Web",
                    "url": "/midi-conversion"
                  }
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "You buy the units from Decap Herentals; Frank fits them, alone or as part of a restoration.",
              "spans": []
            }
          ],
          "image": {},
          "video": {
            "link_type": "Media"
          },
          "image_brief": "Decap MIDI units fitted inside a historic organ, tubing to the key frame visible, lit with a work lamp; 4:3",
          "media_side": "Image left",
          "aspect": "Landscape 4:3",
          "cta_label": "About the MIDI units",
          "cta_link": {
            "link_type": "Web",
            "key": "9a9f87e2-c962-45f0-90ee-09368e8980e7",
            "url": "/midi-conversion"
          },
