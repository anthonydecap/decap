          "success_body": [
            {
              "type": "paragraph",
              "text": "Your message is with Frank. He replies personally; have your photos of the organ ready.",
              "spans": []
            }
          ],
          "aside_title": "Reaching Frank",
          "aside_body": [
            {
              "type": "paragraph",
              "text": "Atelier Frank Decap is independent from Decap Herentals. The easiest way to reach Frank is this form.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "Phone: [TO CHECK: Frank's phone number]",
              "spans": [
