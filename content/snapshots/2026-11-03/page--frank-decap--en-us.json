      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "Who restores your organ",
          "title": "One family, two workshops",
          "body": [
            {
              "type": "paragraph",
              "text": "The Decap family has worked with organs since 1895. Tony Decap builds new organs and develops the technology in Herentals. His brother Frank chose the other side of the craft: keeping historic organs playing as their builders intended.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "Atelier Frank Decap is Frank's own business, separate from Decap Herentals. When you write to him, you deal with the person who will do the work.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "The atelier is on the same site as Decap Herentals, the Decap organ factory on the Langepad in Herentals.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 1448,
              "height": 1086
            },
            "alt": "Frank Decap working among historic organs",
            "copyright": null,
            "url": "https://images.prismic.io/decap/-mRrocqDUWGiAS75_decap-frank-decap-historic-concert-hall-organ-workshop.jpg?auto=format,compress",
            "id": "-mRrocqDUWGiAS75",
