      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "Player and music",
          "title": "One player for the whole ensemble",
          "body": [
            {
              "type": "paragraph",
              "text": "Virtual Orchestrion is the player for the whole Decap ensemble. It sends each instrument its part and shows the music as an animated orchestrion or as a book. When an arrangement calls for ranks your instrument does not have, the player adds them with samples we recorded in our own workshop.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "A music shop with copy-protected arrangements for Decap instruments is coming soon.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 497,
              "height": 312
            },
