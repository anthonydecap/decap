      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "Can I visit the workshop in Herentals?",
            "answer": [
              {
                "type": "paragraph",
                "text": "The workshop is not open for show visits: it is where the organs are built. From time to time we hold open days. If we build an organ for you, you visit the workshop several times during the build to see how it is coming along.",
                "spans": []
              }
            ]
          },
          {
            "question": "Do you deliver outside Belgium?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Yes, we ship worldwide. Decap organs and instruments play in Japan, the US, Australia, Asia and across Europe. Shipping and installation depend on the project and are part of your quote.",
                "spans": []
              }
            ]
          },
          {
            "question": "Who restores historic organs?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Restoration is the work of Atelier Frank Decap, the separate business of Tony's brother Frank. Use the form on his page so your message reaches him directly.",
                "spans": [
                  {
                    "start": 111,
                    "end": 119,
                    "type": "hyperlink",
                    "data": {
                      "link_type": "Web",
                      "url": "/frank-decap"
                    }
                  }
                ]
              }
            ]
          }
        ],
