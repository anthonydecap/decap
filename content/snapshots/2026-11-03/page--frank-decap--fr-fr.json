      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "Qui restaure votre orgue",
          "title": "Une famille, deux ateliers",
          "body": [
            {
              "type": "paragraph",
              "text": "La famille Decap travaille avec les orgues depuis 1895. Tony Decap construit des orgues neufs et développe la technologie à Herentals. Son frère Frank a choisi l'autre versant du métier : faire jouer les orgues historiques comme leurs facteurs l'avaient voulu.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "L'Atelier Frank Decap est l'entreprise de Frank, distincte de Decap Herentals. Quand vous lui écrivez, vous traitez avec la personne qui fera le travail.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "L'atelier se trouve sur le même site que Decap Herentals, la fabrique d'orgues Decap au Langepad à Herentals.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
              "width": 1448,
              "height": 1086
            },
            "alt": "Frank Decap working among historic organs",
            "copyright": null,
            "url": "https://images.prismic.io/decap/-mRrocqDUWGiAS75_decap-frank-decap-historic-concert-hall-organ-workshop.jpg?auto=format,compress",
            "id": "-mRrocqDUWGiAS75",
