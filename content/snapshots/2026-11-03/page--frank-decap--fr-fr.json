      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "Conversion MIDI",
          "title": "Carton et MIDI dans un même orgue",
          "body": [
            {
              "type": "paragraph",
              "text": "Frank installe les modules de conversion MIDI Decap fabriqués à Herentals. Les modules se placent entre le clavier de lecture et le sommier principal : le carton ou le rouleau continue de fonctionner comme avant, et carton et MIDI peuvent même jouer en même temps.",
              "spans": [
                {
                  "start": 19,
                  "end": 51,
                  "type": "hyperlink",
                  "data": {
                    "link_type": "Web",
                    "url": "/midi-conversion"
                  }
                }
              ]
            },
            {
              "type": "paragraph",
              "text": "Vous achetez les modules chez Decap Herentals ; Frank les monte, seuls ou dans le cadre d'une restauration.",
              "spans": []
            }
          ],
          "image": {},
          "video": {
            "link_type": "Media"
          },
          "image_brief": "Decap MIDI units fitted inside a historic organ, tubing to the key frame visible, lit with a work lamp; 4:3",
          "media_side": "Image left",
          "aspect": "Landscape 4:3",
          "cta_label": "À propos des modules MIDI",
          "cta_link": {
            "link_type": "Web",
