        "primary": {
          "eyebrow": "Où ils jouent",
          "title": "Au salon, au café et dans les salles de danse",
          "intro": [
            {
              "type": "paragraph",
              "text": "La plupart des orgues et instruments Decap appartiennent à des particuliers. Ils jouent à la maison, dans un café ou un bar, dans une salle de danse, partout dans le monde.",
              "spans": []
            }
          ],
