        "primary": {
          "mux_hls_url": null,
          "title": "Pipes",
          "subtitle": "A real pipe organ. Made for MIDI.",
          "body": [
            {
              "type": "paragraph",
              "text": "Decap Pipes is a self-playing, MIDI-controlled acoustic pipe instrument. Choose chest-wide pressure regulation, based on the system used in the Decap automatic accordion, or smARTvalve technology for independent pressure control of every pipe.",
              "spans": [],
              "direction": "ltr"
            }
          ],
          "primary_button_text": "How it works",
          "primary_button_link": {
            "link_type": "Any"
          },
          "secondary_button_text": "Explore the system",
          "secondary_button_link": {
            "link_type": "Any"
          },
          "footnote": "Built as an organ façade, compact module, transportable frame or custom installation.",
          "overlay_opacity": null,
          "background_color": "#FFFFFF"
        },
        "id": "instrument_header$12cfc3b5-dc74-4c34-920f-e9cddbfd30b4",
        "slice_type": "instrument_header",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "title": "One pipe instrument. Two pressure systems.",
          "body": [
            {
              "type": "paragraph",
              "text": "The standard Decap system regulates the pressure of the complete chest as one responsive air supply. smARTvalve moves that control to every individual pipe, allowing each note to follow its own pressure curve, articulation and dynamics.",
              "spans": [],
              "direction": "ltr"
            }
          ],
          "image": {
            "dimensions": {
