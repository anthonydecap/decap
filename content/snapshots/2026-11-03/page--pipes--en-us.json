        "version": "initial",
        "items": [],
        "primary": {
          "title": "From global expression to independent voices.",
          "body": [
            {
              "type": "paragraph",
              "text": "Standard chest regulation shapes the complete pipe chest together, supporting crescendo, decrescendo, pitch and modulation effects, LFO vibrato, slope and decay. With smARTvalve, dynamic shaping, note articulation, vibrato, tremolo and pressure curves can be controlled for each pipe independently, enabling polyphonic expression.",
              "spans": [],
              "direction": "ltr"
            }
          ],
