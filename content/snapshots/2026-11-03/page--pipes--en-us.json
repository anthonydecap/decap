      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "item_title": "Standard chest regulation",
            "item_description": [
              {
                "type": "paragraph",
                "text": "The complete chest shares one regulated pressure. This proven Decap system uses the same core airflow-control principle as the self-playing accordion.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "image": {}
          },
          {
            "item_title": "smARTvalve per-pipe control",
            "item_description": [
              {
                "type": "paragraph",
                "text": "Every pipe receives its own electronically controlled pressure. Notes can be shaped independently instead of following one shared chest pressure.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "image": {}
          },
          {
            "item_title": "Real acoustic pipework",
            "item_description": [
              {
                "type": "paragraph",
                "text": "Use wooden or metal pipes, newly built, restored or refurbished. The selected pipework remains responsible for the sound.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "image": {}
          },
          {
            "item_title": "Up to seven ranks",
            "item_description": [
              {
                "type": "paragraph",
                "text": "A compact Pipes system can contain up to seven ranks, configured around the required range, tone and available space.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "image": {}
          }
        ],
        "primary": {
