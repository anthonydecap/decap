      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "question": "Puis-je visiter l'atelier à Herentals ?",
            "answer": [
              {
                "type": "paragraph",
                "text": "L'atelier n'est pas ouvert aux visites : c'est là que les orgues sont construits. De temps en temps, nous organisons des journées portes ouvertes. Si nous construisons un orgue pour vous, vous venez plusieurs fois à l'atelier pendant la construction pour voir comment il avance.",
                "spans": []
              }
            ]
          },
          {
            "question": "Livrez-vous hors de Belgique ?",
            "answer": [
              {
                "type": "paragraph",
                "text": "Oui, nous expédions dans le monde entier. Des orgues et instruments Decap jouent au Japon, aux États-Unis, en Australie, en Asie et dans toute l'Europe. Le transport et l'installation dépendent du projet et font partie de votre devis.",
                "spans": []
              }
            ]
          },
          {
            "question": "Qui restaure les orgues historiques ?",
            "answer": [
              {
                "type": "paragraph",
                "text": "La restauration est le travail de l'Atelier Frank Decap, l'entreprise distincte de Frank, le frère de Tony. Utilisez le formulaire de sa page pour que votre message lui parvienne directement.",
                "spans": [
                  {
                    "start": 134,
                    "end": 141,
                    "type": "hyperlink",
                    "data": {
                      "link_type": "Web",
                      "url": "/frank-decap"
                    }
                  }
                ]
              }
            ]
          }
        ],
