      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "step_headline": "MIDI command → target pressure",
            "step_subline": "Every note begins as a pressure curve — attack, decay, sustain, release — not an on/off.",
            "step_number": 1,
            "step_video": {
              "link_type": "Web",
              "key": "dd8929eb-401f-4aaa-9de2-b8624cf6ef89",
              "url": "https://stream.mux.com/R8PE5F2GU7pDiYz1wR7iqHhpDH0200pN2zsjKVLNRK4bw.m3u8"
            },
            "step_image": {}
          },
          {
            "step_headline": "Voice-coil motor → ultra-fast control",
            "step_subline": "A loudspeaker-like motor moves a featherweight piston to shape airflow continuously.",
            "step_number": 2,
            "step_video": {
              "link_type": "Web",
              "key": "eb16fc51-df1b-4496-a607-766c40f38402",
              "url": "https://stream.mux.com/jTd6xhs5Kbx02cmTs887mUyHaFPVcSFBDEVrPFD0201iP4.m3u8"
            },
            "step_image": {}
          },
          {
            "step_headline": "Pressure sensor → real-time regulation",
            "step_subline": "Wind is measured 9,000×/s and corrected 2,000×/s so actual pressure follows the curve exactly.",
            "step_number": 3,
            "step_video": {
              "link_type": "Web",
              "key": "11219b87-f1f8-47a3-a7ee-5d94d9e1ad18",
              "url": "https://stream.mux.com/iujtj6Hv520202AUEKFEHoZ9SKIRNJMXYyKDnOLO01MjtY.m3u8"
            },
            "step_image": {}
          },
          {
            "step_headline": "Real wind control → living sound",
            "step_subline": "Because smARTvalve regulates pressure, pipes breathe, swell and speak with natural expression.",
            "step_number": 4,
            "step_video": {
              "link_type": "Web",
              "key": "be46dc09-b29b-4ced-ac4e-e0eb1305064a",
              "url": "https://stream.mux.com/SymnsrJ9qdDBss91ZFIV7JSXDvofQIvdobnBjrAmLlw.m3u8"
            },
            "step_image": {}
          }
        ],
