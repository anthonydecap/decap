        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "possibility_title": "Dynamic shaping",
            "possibility_description": [
              {
                "type": "paragraph",
                "text": "Play true crescendos and decrescendos. Instead of a fixed volume, pipes can swell, breathe, and fade — just like strings, horns, or voices.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "possibility_title": "Articulation control",
            "possibility_description": [
              {
                "type": "paragraph",
                "text": "Shape the beginning and end of each note. Create whispering onsets, sharp staccatos, or smooth legatos by sculpting the pressure curve.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "possibility_title": "Vibrato & tremolo",
            "possibility_description": [
              {
                "type": "paragraph",
                "text": "Add shimmer, warmth, or agitation. By modulating pressure microscopically, smARTvalve lets pipes sing with vibrato or pulse with tremolo.",
                "spans": [
                  {
                    "start": 97,
                    "end": 101,
                    "type": "em"
                  }
                ],
                "direction": "ltr"
              }
            ]
          },
          {
            "possibility_title": "Independent voices",
            "possibility_description": [
              {
                "type": "paragraph",
                "text": "Each pipe has its own processor. You can hold one note in the background while another leaps forward, giving true polyphonic expression.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          }
        ],
        "primary": {
          "section_title": [
            {
              "type": "paragraph",
              "text": "Expression & Playability",
              "spans": [],
              "direction": "ltr"
            }
          ],
          "section_subtitle": [
            {
              "type": "paragraph",
              "text": "smARTvalve doesn’t just open or close.\nIt controls air pressure in real time — the most fundamental element of pipe sound.\nThat one breakthrough turns every organ pipe into a living, expressive instrument.",
              "spans": [
                {
                  "start": 0,
                  "end": 38,
                  "type": "strong"
                },
                {
                  "start": 51,
                  "end": 76,
                  "type": "strong"
                }
              ],
              "direction": "ltr"
            }
          ],
          "background_color": null
        },
        "id": "smart_valve_possibilities$22a93382-0e42-4819-a4f6-42081cfe4b7a",
        "slice_type": "smart_valve_possibilities",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": null,
          "statement": "The dynamics were always *hidden in the pipe.* smARTvalve lets you *play them.*",
          "caption": [
            {
              "type": "paragraph",
              "text": "Not by changing the pipe, but by giving it exactly the wind it needs, note by note, 2,000 times a second.",
              "spans": []
            }
          ],
          "tone": "Default"
        },
        "id": "site_statement$0745d9e9-9be7-4f9e-b857-9389b4595683",
        "slice_type": "site_statement",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "title": [
            {
              "type": "heading1",
              "text": "Expanding the Organ’s Potential.",
              "spans": [],
              "direction": "ltr"
            }
          ],
          "description": [
            {
              "type": "paragraph",
              "text": "Marion and Maciej of Gamut Inc. set out to test L’Explorateur, the world’s first organ equipped with the smARTvalve. Taking it far beyond conventional boundaries, they approached the instrument as a living laboratory. By pushing the smARTvalve system to its extremes, they uncovered bold new textures, dynamic responsiveness, and expressive possibilities never before accessible in traditional organ design. Their exploration revealed how the smARTvalve transforms the organ—making it radically more versatile by expanding airflow control, articulation, and tonal flexibility—far beyond what was ever possible before.",
              "spans": [],
              "direction": "ltr"
            }
          ],
          "youtube_url": "https://www.youtube.com/watch?v=IvDFsVgjlno",
          "thumbnail_image": {
            "dimensions": {
              "width": 991,
              "height": 544
            },
            "alt": null,
            "copyright": null,
            "url": "https://images.prismic.io/decap/aZT9UlWLo0XkEm6Z_Screenshot2026-02-18at00.41.57.png?auto=format%2Ccompress&rect=184%2C103%2C756%2C415&w=991&h=544",
            "id": "aZT9UlWLo0XkEm6Z",
            "edit": {
              "x": 184,
              "y": 103,
              "zoom": 1.310846560846561,
              "background": "transparent"
            }
          },
          "background_color": null
        },
        "id": "smart_valve_video$0e945ab1-a40f-4ff5-b86c-a8b4ed732f45",
        "slice_type": "smart_valve_video",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "card_title": "Identity",
            "card_description": [
              {
                "type": "paragraph",
                "text": "Every valve — and therefore every pipe — has its own unique identity.\nThis makes it possible to individually address, control, and configure each element of the instrument.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "card_icon": "id"
          },
          {
            "card_title": "Combine",
            "card_description": [
              {
                "type": "paragraph",
                "text": "Because every valve and pipe has its own identity, custom stop combinations are virtually infinite.\nThis allows for entirely new registrations and sound structures beyond traditional organ design.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "card_icon": "organ_stops"
          },
          {
            "card_title": "Update",
            "card_description": [
              {
                "type": "paragraph",
                "text": "No matter the size of the setup — firmware updates are deployed with a single action.\nNew firmware is automatically sent to every valve, keeping the system in sync and future-proof by design.",
                "spans": [],
                "direction": "ltr"
              }
            ],
            "card_icon": "update"
          }
        ],
        "primary": {
          "title": [
            {
              "type": "paragraph",
              "text": "Intelligence inside every pipe",
              "spans": [],
              "direction": "ltr"
            }
          ],
          "subtitle": [],
          "show_animation": true,
          "background_color": null
        },
