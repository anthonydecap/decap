                "zoom": 1,
                "background": "transparent"
              }
            },
            "item_title": "Any MIDI Controller",
            "item_description": [
              {
                "type": "paragraph",
                "text": "smARTvalve responds to standard MIDI input from any controller, enabling direct mapping of keys, faders, aftertouch, or CC messages to dynamic pressure control.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "image": {
              "dimensions": {
                "width": 1280,
                "height": 720
              },
