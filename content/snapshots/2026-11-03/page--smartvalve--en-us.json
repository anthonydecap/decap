            "item_title": "Traditional Organ Consoles",
            "item_description": [
              {
                "type": "paragraph",
                "text": "Play exactly as you always have with a new layer of continuous expression beneath every note. smARTvalve enhances the instrument without changing its identity.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          }
        ],
        "primary": {
          "title": [
            {
              "type": "paragraph",
              "text": "Three ways to play",
              "spans": [],
              "direction": "ltr"
            }
          ],
          "description": [
            {
              "type": "paragraph",
              "text": "From a cathedral console to a laptop in a studio, you control pressure with the tools you already use.",
              "spans": [
                {
                  "start": 62,
                  "end": 70,
                  "type": "em"
                }
              ],
