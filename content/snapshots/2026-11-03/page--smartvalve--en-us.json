      },
      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "title": "The First Organ Valve That Shapes Air",
          "subtitle": [
            {
              "type": "paragraph",
              "text": "smARTvalve is a groundbreaking digital valve system that introduces a completely new way of controlling airflow in organ pipes. Instead of simply opening or closing, each valve can shape the air in real time — enabling dynamic wind control, expressive pressure changes, and musical nuance never before possible.",
              "spans": [],
              "direction": "ltr"
            }
          ],
          "button_text": "Discover how it works",
          "button_link": {
            "link_type": "Any"
          },
          "background_video": {
            "link_type": "Web",
            "key": "f8c346c0-55f4-4ddb-b50a-bf8b71267dbb",
            "url": "https://stream.mux.com/jICEIVGWf78011cV6iYuEoJddL6D01nduJkTmi8nFtfl4.m3u8"
          },
          "overlay_opacity": null,
          "background_color": null
        },
        "id": "smart_valve_video_hero$13aa2d85-4cf7-4774-990d-be2f4e3b1f56",
        "slice_type": "smart_valve_video_hero",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [
          {},
          {}
        ],
        "primary": {
          "title": [
            {
              "type": "paragraph",
              "text": "Expression. Modulation. Freedom.",
              "spans": [],
              "direction": "ltr"
            }
          ],
          "subtitle": [
            {
              "type": "paragraph",
              "text": "Treat pipes like an analog modular synth module.",
              "spans": [
                {
                  "start": 20,
