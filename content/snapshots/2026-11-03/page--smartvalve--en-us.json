        "primary": {
          "headline": "Optical MIDI",
          "description": [
            {
              "type": "paragraph",
              "text": "Due to the extreme control possibilities of the smARTvalve, high-speed MIDI data is necessary. For this reason we introduced optical MIDI with a speed of 300,000 bytes/sec. Each MIDI 1.0 command uses 3 bytes. @ 300,000 bytes/sec → 100,000 commands per second (150,000 with MIDI running state). With regular DIN MIDI cable, switching 1,000 pipes ON would take 1 second. With optical MIDI, the same task is done in 1 millisecond. ",
              "spans": [],
              "direction": "ltr"
            }
