        "id": "smart_valve_story$bb45dbb3-878a-492d-95b7-80b6b8446f5f",
        "slice_type": "smart_valve_story",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "point": "VPP set per pipe, stored in the valve"
          },
          {
            "point": "0–400% of the VPP, in real time"
          },
          {
            "point": "A speed-controlled blower supplies the chest"
          }
        ],
        "primary": {
          "eyebrow": "Voiced Pipe Pressure",
          "title": "Voice with a slider. Play up to four times the pressure.",
          "body": [
            {
              "type": "paragraph",
              "text": "The pressure a pipe is voiced at is its Voiced Pipe Pressure, or VPP: the 100% level. You set it for each pipe as a simple number, and it is stored in the valve itself. Want an even rank, or a little more presence in the bass? Adjust it and store it.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "While you play, every pipe can go anywhere from 0 to 400% of its VPP, in real time. A pipe voiced at 80 mm plays anywhere between silence and 320 mm, and the speed-controlled blower supplies the chest pressure needed. An expression pedal, note velocity, aftertouch: anything that sends controller data can play it.",
              "spans": []
            }
          ],
          "image": {},
          "video": {
            "link_type": "Media"
          },
          "image_brief": "PipeCreator on screen with a VPP slider per pipe of a rank, next to the pipes, 4:3",
          "media_side": "Image left",
          "aspect": "Landscape 4:3",
          "cta_label": null,
          "cta_link": {
            "link_type": "Any"
          },
          "tone": "Tinted"
        },
        "id": "site_text_media$32e9c400-b4ef-43f6-b9cb-e12a6082503d",
        "slice_type": "site_text_media",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "size": "Large",
            "style": "Dark",
            "visual": "Velocity",
            "value": "5 ms – 12.7 s",
            "value_label": null,
            "title": "A full wind envelope for every note",
            "body": "Delay, start level, attack, decay, sustain and release, each with its own curve: from a slow swell to a quick rise with a soft landing. Play the key again during the release and the pipe carries on, without a gap.",
            "link_label": null,
            "link": {
              "link_type": "Any"
            }
          },
          {
            "size": "Small",
            "style": "Light",
            "visual": "Pipe",
            "value": null,
            "value_label": null,
            "title": "Speech",
            "body": "A controlled pressure accent at the start of each note, from a gentle chiff to a pronounced attack. Velocity can set its depth.",
            "link_label": null,
            "link": {
              "link_type": "Any"
            }
          },
          {
            "size": "Small",
            "style": "Accent",
            "visual": "None",
            "value": "25 Hz",
            "value_label": "Vibrato 1",
            "title": null,
            "body": "From a slow wave to a fast flutter: a tremulant in every pipe.",
            "link_label": null,
            "link": {
              "link_type": "Any"
            }
          },
          {
            "size": "Small",
            "style": "Light",
            "visual": "None",
            "value": "400 Hz+",
            "value_label": "Vibrato 2, extended mode",
            "title": null,
            "body": "Into the audible range, where vibrato becomes part of the pipe's tone colour.",
            "link_label": null,
            "link": {
              "link_type": "Any"
            }
          },
          {
            "size": "Small",
            "style": "Light",
            "visual": "Chip",
            "value": null,
            "value_label": null,
            "title": "Soft close or slap",
            "body": "Choose how a note ends: a soft close, or a percussive slap.",
            "link_label": null,
            "link": {
              "link_type": "Any"
            }
          },
          {
            "size": "Wide",
            "style": "Dark",
            "visual": "Wind",
            "value": null,
            "value_label": null,
            "title": "The whole organ breathes together",
            "body": "Every pipe's vibrato locks smoothly to the MIDI clock, without the drift of a mechanical tremulant. Up to ±75% depth each, and each with its own envelope.",
            "link_label": null,
            "link": {
              "link_type": "Any"
            }
          },
          {
            "size": "Wide",
            "style": "Light",
            "visual": "None",
            "value": null,
            "value_label": null,
            "title": "One key of a chord swells",
            "body": "Polyphonic aftertouch sets the pressure of each sounding pipe on its own; channel aftertouch moves a whole rank.",
            "link_label": null,
            "link": {
              "link_type": "Any"
            }
          }
        ],
        "primary": {
          "eyebrow": "Built into every valve",
          "title": "An envelope and two vibratos for every pipe",
          "intro": [
            {
              "type": "paragraph",
              "text": "Every smARTvalve has its own envelope generator and two LFOs, running on its own clock of 2,000 times a second. Every pipe follows its own shape with millisecond accuracy, independent of the others, yet in sync.",
              "spans": []
            }
          ],
          "tone": "Default"
        },
