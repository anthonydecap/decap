        "id": "smart_valve_chest$85c95b43-fc14-49d9-883a-5b623249ed29",
        "slice_type": "smart_valve_chest",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "icon": "midi_2",
            "description": [
              {
                "type": "paragraph",
                "text": "MIDI Compatibility ensures smARTvalve works within the established MIDI 1.0 standard, providing universal integration with existing hardware and software. The system architecture is designed to support future implementation of MIDI 2.0 as the ecosystem evolves.",
                "spans": [
                  {
                    "start": 0,
                    "end": 18,
                    "type": "strong"
                  }
                ],
                "direction": "ltr"
              }
            ]
          },
          {
            "icon": "adsr",
            "description": [
              {
                "type": "paragraph",
                "text": "LFO & ADSR via MIDI Control Change allows modulation parameters such as LFO rate and envelope behavior to be controlled externally. This makes it possible to dynamically shape airflow using automation, hardware controllers, or performance gestures.",
                "spans": [
                  {
                    "start": 0,
                    "end": 34,
                    "type": "strong"
                  }
                ],
                "direction": "ltr"
              },
              {
                "type": "paragraph",
                "text": "",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "icon": "polyphonic_aftertouch",
            "description": [
              {
                "type": "paragraph",
                "text": "Polyphonic Aftertouch enables per-note continuous wind control, allowing each key to independently shape pressure in real time. This unlocks true polyphonic expression within chords and complex passages.",
                "spans": [
                  {
                    "start": 0,
                    "end": 21,
                    "type": "strong"
                  }
                ],
                "direction": "ltr"
              }
            ]
          }
        ],
        "primary": {
          "section_title": [],
          "background_color": null
        },
