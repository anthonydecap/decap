          {
            "label": "Attack",
            "value": "Full pressure in about 10 ms",
            "note": "Without overshoot or dip"
          },
          {
            "label": "Pressure range",
            "value": "0–400% of the Voiced Pipe Pressure",
            "note": "VPP set per pipe, stored in the valve"
          },
          {
            "label": "Regulation",
            "value": "No external regulator or reservoir",
            "note": "A speed-controlled blower supplies the chest"
          },
          {
            "label": "Drive",
            "value": "Voice-coil actuator",
            "note": "Silent and proportional, not a solenoid"
          },
          {
            "label": "Calibration",
            "value": "Self-calibrating",
            "note": "Learns from every attack"
          },
          {
            "label": "Wind envelope",
            "value": "Delay, start level, attack, decay, sustain, release",
            "note": "5 ms to 12.7 s, an adjustable curve per stage"
          },
          {
