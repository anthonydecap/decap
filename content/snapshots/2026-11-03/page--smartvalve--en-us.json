            "item_title": "Computer / DAW",
            "item_description": [
              {
                "type": "paragraph",
                "text": "Use your DAW to shape air like sound. Draw pressure curves, automate movement, and build evolving wind structures inside your production environment.",
                "spans": [],
                "direction": "ltr"
              }
            ]
          },
          {
            "image": {
              "dimensions": {
                "width": 1744,
