        "id": "site_text_media$5d6ef6a2-2a53-4f8a-a41b-b1f88cffe8c1",
        "slice_type": "site_text_media",
        "slice_label": null
      },
      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "In the room",
          "title": "The placement becomes part of the sound",
          "body": [
            {
              "type": "paragraph",
              "text": "Because the modules are separate, they can stand together like one organ, or apart as independent divisions around the audience. Each placement changes how the instrument meets the room. “The same Flute module has a different sound when placed in the front, on the side or behind another module.”",
              "spans": [
                {
                  "start": 187,
                  "end": 296,
                  "type": "em"
                }
              ]
            }
          ],
