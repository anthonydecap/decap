      {
        "variation": "default",
        "version": "initial",
        "items": [
          {
            "year": "2013",
            "title": "The idea",
            "body": [
              {
                "type": "paragraph",
                "text": "Yves Rechsteiner, new artistic director of Toulouse les Orgues, wants an organ that can perform outside churches.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null,
            "highlight": false
          },
          {
            "year": "2017",
            "title": "On hold",
            "body": [
              {
                "type": "paragraph",
                "text": "The transportable organ project stops for financial reasons.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null,
            "highlight": false
          },
          {
            "year": "2019",
            "title": "Meeting Tony Decap",
            "body": [
              {
                "type": "paragraph",
                "text": "Through a teaser of Stephan Eicher's Die Automaten. Rechsteiner orders a MIDI-controlled instrument.",
                "spans": [
                  {
                    "start": 37,
                    "end": 50,
                    "type": "em"
                  }
                ]
              }
            ],
            "image": {},
            "image_brief": null,
            "highlight": false
          },
          {
            "year": "2021",
            "title": "Construction starts",
            "body": [
              {
                "type": "paragraph",
                "text": "During the build, Decap proposes something new: control the wind not per wind chest, but per pipe.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null,
            "highlight": false
          },
          {
            "year": "2023",
            "title": "First performances",
            "body": [
              {
                "type": "paragraph",
                "text": "After two years of work and research, L'Explorateur plays with the first generation of valves. The performances begin.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null,
            "highlight": false
          },
          {
            "year": "2023–2025",
            "title": "smARTvalve",
            "body": [
              {
                "type": "paragraph",
                "text": "Tony Decap designs the second generation, smARTvalve, and the module electronics are rebuilt around it.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null,
            "highlight": true
          },
          {
            "year": "2025",
            "title": "The first wind synthesizer",
            "body": [
              {
                "type": "paragraph",
                "text": "smARTvalve in concert: every pipe of a transportable church organ controlled on its own. Among the concerts, a Moondog tribute in Lyon's Chapelle de la Trinité.",
                "spans": []
              }
            ],
            "image": {},
            "image_brief": null,
            "highlight": true
          },
          {
            "year": "2026",
            "title": "Next steps",
            "body": [
              {
                "type": "paragraph",
                "text": "New valves and wind chests, console software, tonal adjustment and a free-reed rank from an 1830 Muller orgue expressif.",
                "spans": [
                  {
                    "start": 104,
                    "end": 119,
                    "type": "em"
                  }
                ]
              }
            ],
            "image": {},
            "image_brief": null,
            "highlight": false
          }
        ],
        "primary": {
          "eyebrow": "Timeline",
          "title": "From idea to wind synthesizer",
          "intro": [],
          "tone": "Default"
        },
