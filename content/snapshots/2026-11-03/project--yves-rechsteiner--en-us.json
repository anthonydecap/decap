      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "The pipework",
          "title": "Old pipes, a new life",
          "body": [
            {
              "type": "paragraph",
              "text": "Most of the pipework is second-hand, from the late 19th and early 20th century, and was voiced by Jean Daldosso. New free-reed pipes were made by Orgelbau Orglez in Brittany: free reeds change their dynamics without changing pitch, a perfect match for wind control per pipe.",
              "spans": []
            },
            {
              "type": "paragraph",
              "text": "With smARTvalve, one rank can do far more than it was built for: fifty Flute pipes give a whole range of colours through the wind alone.",
              "spans": []
            }
          ],
          "image": {
            "dimensions": {
