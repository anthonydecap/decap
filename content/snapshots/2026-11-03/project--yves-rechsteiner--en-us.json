        "primary": {
          "layout": "Split",
          "eyebrow": "Work · Yves Rechsteiner",
          "title": "L'Explorateur: a transportable concert organ with smARTvalve on every pipe",
          "intro": [
            {
              "type": "paragraph",
              "text": "Organist Yves Rechsteiner wanted a pipe organ that could play wherever the music is, not only in churches. Together we built L'Explorateur: twelve modules that travel in one van, set up in under two hours, with the wind of every pipe under control. Rechsteiner calls the result a physical synthesizer.",
              "spans": []
            }
          ],
