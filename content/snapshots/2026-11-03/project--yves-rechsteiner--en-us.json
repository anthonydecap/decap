      {
        "variation": "default",
        "version": "initial",
        "items": [],
        "primary": {
          "eyebrow": "What comes next",
          "title": "An instrument that keeps growing",
          "body": [
            {
              "type": "paragraph",
              "text": "L'Explorateur is not finished, and that is the point.",
              "spans": []
            },
            {
              "type": "list-item",
              "text": "Osmose keyboard: the wind pressure follows the key, so the organist plays with a piano or clavichord technique.",
              "spans": [
                {
