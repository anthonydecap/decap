{
  "id": "settings",
  "label": "Settings",
  "format": "page",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "site_name": {
        "type": "Text",
        "config": {
          "label": "Site Name",
          "placeholder": "Decap"
        }
      },
      "logo": {
        "type": "Image",
        "config": {
          "label": "Logo",
          "constraint": {
            "width": 400,
            "height": 200
          },
          "thumbnails": []
        }
      },
      "contact_button_text": {
        "type": "Text",
        "config": {
          "label": "Contact Button Text",
          "placeholder": "Contact us"
        }
      },
      "contact_button_link": {
        "type": "Link",
        "config": {
          "label": "Contact Button Link",
          "placeholder": "/contact",
          "select": null
        }
      }
    },
    "Navigation": {
      "navigation": {
        "type": "Group",
        "config": {
          "label": "Navigation Items",
          "fields": {
            "label": {
              "type": "Text",
              "config": {
                "label": "Label",
                "placeholder": "Work"
              }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "Link",
                "placeholder": "/work",
                "select": null
              }
            }
          }
        }
      }
    },
    "Footer": {
      "footer_sections": {
        "type": "Group",
        "config": {
          "label": "Footer Sections",
          "fields": {
            "section_title": {
              "type": "Text",
              "config": {
                "label": "Section Title",
                "placeholder": "Work"
              }
            },
            "section_links": {
              "type": "Group",
              "config": {
                "label": "Section Links",
                "fields": {
                  "link_text": {
                    "type": "Text",
                    "config": {
                      "label": "Link Text",
                      "placeholder": "Our Work"
                    }
                  },
                  "link_url": {
                    "type": "Link",
                    "config": {
                      "label": "Link URL",
                      "placeholder": "/work",
                      "select": null
                    }
                  }
                }
              }
            }
          }
        }
      },
      "company_name": {
        "type": "Text",
        "config": {
          "label": "Company name",
          "placeholder": "Decap Herentals"
        }
      },
      "company_address": {
        "type": "StructuredText",
        "config": {
          "label": "Address",
          "placeholder": "Langepad 51C, 2200 Herentals, Belgium",
          "multi": "paragraph"
        }
      },
      "company_phone": {
        "type": "Text",
        "config": {
          "label": "Phone",
          "placeholder": "+32 14 22 44 94"
        }
      },
      "company_email": {
        "type": "Text",
        "config": {
          "label": "Email",
          "placeholder": "info@decap.be"
        }
      },
      "company_vat": {
        "type": "Text",
        "config": {
          "label": "VAT / company number",
          "placeholder": "BE 0450.352.984"
        }
      },
      "copyright_text": {
        "type": "Text",
        "config": {
          "label": "Copyright Text",
          "placeholder": "\u00a9 Decap Herentals"
        }
      }
    }
  }
}
