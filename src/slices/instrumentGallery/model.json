{
  "id": "instrument_gallery",
  "type": "SharedSlice",
  "name": "InstrumentGallery",
  "description": "Horizontal swipe gallery of captioned image tiles",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "section_title": { "type": "Text", "config": { "label": "Section title" } },
        "section_subtitle": {
          "type": "StructuredText",
          "config": {
            "label": "Section subtitle",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "background_color": {
          "type": "Color",
          "config": { "label": "Background", "placeholder": "#0a0a0a" }
        }
      },
      "items": {
        "image": {
          "type": "Image",
          "config": { "label": "Image", "constraint": {}, "thumbnails": [] }
        },
        "title": { "type": "Text", "config": { "label": "Title" } },
        "description": {
          "type": "StructuredText",
          "config": {
            "label": "Description",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        }
      }
    }
  ]
}
