{
  "id": "site_steps",
  "type": "SharedSlice",
  "name": "SiteSteps",
  "description": "Numbered process steps, with optional image per step.",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow",
            "placeholder": "Small label above the title"
          }
        },
        "title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": ""
          }
        },
        "intro": {
          "type": "StructuredText",
          "config": {
            "label": "Intro",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "tone": {
          "type": "Select",
          "config": {
            "label": "Section tone",
            "options": [
              "Default",
              "Tinted",
              "Dark band"
            ],
            "default_value": "Default"
          }
        }
      },
      "items": {
        "title": {
          "type": "Text",
          "config": {
            "label": "Step title",
            "placeholder": ""
          }
        },
        "body": {
          "type": "StructuredText",
          "config": {
            "label": "Step text",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "image": {
          "type": "Image",
          "config": {
            "label": "Image (optional)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "image_brief": {
          "type": "Text",
          "config": {
            "label": "Photo brief (shown while the image is empty)",
            "placeholder": "e.g. Accordion Pedestal, front view, black backdrop, 4:3"
          }
        }
      }
    }
  ]
}
