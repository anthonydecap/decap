{
  "id": "site_hero",
  "type": "SharedSlice",
  "name": "SiteHero",
  "description": "Page hero (H1) with intro, two buttons and an image. Split, centered or full-bleed.",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "layout": {
          "type": "Select",
          "config": {
            "label": "Layout",
            "options": [
              "Split",
              "Centered",
              "Full-bleed image",
              "Video showcase"
            ],
            "default_value": "Split"
          }
        },
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow",
            "placeholder": ""
          }
        },
        "title": {
          "type": "Text",
          "config": {
            "label": "Title (H1)",
            "placeholder": ""
          }
        },
        "intro": {
          "type": "StructuredText",
          "config": {
            "label": "Intro",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "primary_cta_label": {
          "type": "Text",
          "config": {
            "label": "Primary button label",
            "placeholder": ""
          }
        },
        "primary_cta_link": {
          "type": "Link",
          "config": {
            "label": "Primary button link",
            "allowTargetBlank": true,
            "select": null
          }
        },
        "secondary_cta_label": {
          "type": "Text",
          "config": {
            "label": "Secondary button label",
            "placeholder": ""
          }
        },
        "secondary_cta_link": {
          "type": "Link",
          "config": {
            "label": "Secondary button link",
            "allowTargetBlank": true,
            "select": null
          }
        },
        "note": {
          "type": "Text",
          "config": {
            "label": "Small note under the buttons",
            "placeholder": ""
          }
        },
        "image": {
          "type": "Image",
          "config": {
            "label": "Image (also the poster while a video loads)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "mux_video": {
          "type": "Text",
          "config": {
            "label": "Mux video instead of the image (optional)",
            "placeholder": "https://stream.mux.com/….m3u8 or playback ID"
          }
        },
        "image_brief": {
          "type": "Text",
          "config": {
            "label": "Photo brief (shown while the image is empty)",
            "placeholder": "e.g. Accordion Pedestal, front view, black backdrop, 4:3"
          }
        },
        "image_shape": {
          "type": "Select",
          "config": {
            "label": "Image shape (Split and Centered)",
            "options": [
              "Default",
              "Portrait 4:5",
              "Landscape 4:3",
              "Square",
              "Wide 16:9"
            ],
            "default_value": "Default"
          }
        },
        "image_fit": {
          "type": "Select",
          "config": {
            "label": "Image fit",
            "options": [
              "Auto",
              "Cover",
              "Contain"
            ],
            "default_value": "Auto"
          }
        },
        "image_position": {
          "type": "Select",
          "config": {
            "label": "Image position (also the zoom point)",
            "options": [
              "Center",
              "Top",
              "Bottom",
              "Left",
              "Right",
              "Top left",
              "Top right",
              "Bottom left",
              "Bottom right"
            ],
            "default_value": "Center"
          }
        },
        "image_zoom": {
          "type": "Select",
          "config": {
            "label": "Image zoom",
            "options": [
              "100%",
              "110%",
              "125%",
              "150%"
            ],
            "default_value": "100%"
          }
        },
        "overlay": {
          "type": "Select",
          "config": {
            "label": "Darkening behind the text (Full-bleed)",
            "options": [
              "Medium",
              "Light",
              "Strong",
              "None"
            ],
            "default_value": "Medium"
          }
        },
        "blur": {
          "type": "Select",
          "config": {
            "label": "Effect: blur",
            "options": [
              "None",
              "Light",
              "Medium",
              "Heavy"
            ],
            "default_value": "None"
          }
        },
        "dim": {
          "type": "Select",
          "config": {
            "label": "Effect: dim",
            "options": [
              "None",
              "Light",
              "Medium",
              "Heavy"
            ],
            "default_value": "None"
          }
        },
        "color_effect": {
          "type": "Select",
          "config": {
            "label": "Effect: colour (also on the video)",
            "options": [
              "None",
              "Desaturate",
              "Black & white",
              "Warm",
              "Cool",
              "Vivid",
              "Faded"
            ],
            "default_value": "None"
          }
        },
        "vignette": {
          "type": "Boolean",
          "config": {
            "label": "Effect: vignette (darker edges)",
            "default_value": false
          }
        },
        "slow_zoom": {
          "type": "Boolean",
          "config": {
            "label": "Effect: slow zoom (Ken Burns)",
            "default_value": false
          }
        },
        "tone": {
          "type": "Select",
          "config": {
            "label": "Section tone",
            "options": [
              "Default",
              "Tinted",
              "Dark band"
            ],
            "default_value": "Default"
          }
        }
      },
      "items": {}
    }
  ]
}
