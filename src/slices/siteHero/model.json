{
  "id": "site_hero",
  "type": "SharedSlice",
  "name": "SiteHero",
  "description": "Page hero (H1) with intro, two buttons and an image. Split, centered or full-bleed.",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "layout": {
          "type": "Select",
          "config": {
            "label": "Layout",
            "options": [
              "Split",
              "Centered",
              "Full-bleed image"
            ],
            "default_value": "Split"
          }
        },
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow",
            "placeholder": ""
          }
        },
        "title": {
          "type": "Text",
          "config": {
            "label": "Title (H1)",
            "placeholder": ""
          }
        },
        "intro": {
          "type": "StructuredText",
          "config": {
            "label": "Intro",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "primary_cta_label": {
          "type": "Text",
          "config": {
            "label": "Primary button label",
            "placeholder": ""
          }
        },
        "primary_cta_link": {
          "type": "Link",
          "config": {
            "label": "Primary button link",
            "allowTargetBlank": true,
            "select": null
          }
        },
        "secondary_cta_label": {
          "type": "Text",
          "config": {
            "label": "Secondary button label",
            "placeholder": ""
          }
        },
        "secondary_cta_link": {
          "type": "Link",
          "config": {
            "label": "Secondary button link",
            "allowTargetBlank": true,
            "select": null
          }
        },
        "note": {
          "type": "Text",
          "config": {
            "label": "Small note under the buttons",
            "placeholder": ""
          }
        },
        "image": {
          "type": "Image",
          "config": {
            "label": "Image (also the poster while a video loads)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "mux_video": {
          "type": "Text",
          "config": {
            "label": "Mux video instead of the image (optional)",
            "placeholder": "https://stream.mux.com/….m3u8 or playback ID"
          }
        },
        "image_brief": {
          "type": "Text",
          "config": {
            "label": "Photo brief (shown while the image is empty)",
            "placeholder": "e.g. Accordion Pedestal, front view, black backdrop, 4:3"
          }
        },
        "tone": {
          "type": "Select",
          "config": {
            "label": "Section tone",
            "options": [
              "Default",
              "Tinted",
              "Dark band"
            ],
            "default_value": "Default"
          }
        }
      },
      "items": {}
    }
  ]
}
