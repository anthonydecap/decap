{
  "id": "site_tiles",
  "type": "SharedSlice",
  "name": "SiteTiles",
  "description": "Apple-style product tiles: full-width or half-width, each with its own style, a headline, one line and two links.",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "tone": {
          "type": "Select",
          "config": {
            "label": "Section tone",
            "options": [
              "Default",
              "Tinted",
              "Dark band"
            ],
            "default_value": "Default"
          }
        }
      },
      "items": {
        "size": {
          "type": "Select",
          "config": {
            "label": "Size",
            "options": [
              "Full",
              "Half"
            ],
            "default_value": "Full"
          }
        },
        "style": {
          "type": "Select",
          "config": {
            "label": "Tile style",
            "options": [
              "Light",
              "Dark",
              "SmartValve",
              "Orchestrionix",
              "Atelier"
            ],
            "default_value": "Light"
          }
        },
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow / product name",
            "placeholder": ""
          }
        },
        "title": {
          "type": "Text",
          "config": {
            "label": "Headline",
            "placeholder": ""
          }
        },
        "tagline": {
          "type": "Text",
          "config": {
            "label": "One line",
            "placeholder": ""
          }
        },
        "note": {
          "type": "Text",
          "config": {
            "label": "Small note",
            "placeholder": "e.g. € 2,599 · ships from stock"
          }
        },
        "primary_label": {
          "type": "Text",
          "config": {
            "label": "Primary link label",
            "placeholder": "Learn more"
          }
        },
        "primary_link": {
          "type": "Link",
          "config": {
            "label": "Primary link",
            "allowTargetBlank": true,
            "select": null
          }
        },
        "secondary_label": {
          "type": "Text",
          "config": {
            "label": "Secondary link label",
            "placeholder": "Buy"
          }
        },
        "secondary_link": {
          "type": "Link",
          "config": {
            "label": "Secondary link",
            "allowTargetBlank": true,
            "select": null
          }
        },
        "image": {
          "type": "Image",
          "config": {
            "label": "Background image (photo or transparent PNG)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "image_fit": {
          "type": "Select",
          "config": {
            "label": "Image fit",
            "options": [
              "Cover",
              "Contain"
            ],
            "default_value": "Cover"
          }
        },
        "image_position": {
          "type": "Select",
          "config": {
            "label": "Image position",
            "options": [
              "Center",
              "Top",
              "Bottom",
              "Left",
              "Right",
              "Top left",
              "Top right",
              "Bottom left",
              "Bottom right"
            ],
            "default_value": "Center"
          }
        },
        "image_size": {
          "type": "Select",
          "config": {
            "label": "Image size (with Contain)",
            "options": [
              "100%",
              "85%",
              "70%",
              "55%"
            ],
            "default_value": "100%"
          }
        },
        "overlay": {
          "type": "Select",
          "config": {
            "label": "Text legibility over the image",
            "options": [
              "None",
              "Soft",
              "Strong"
            ],
            "default_value": "None"
          }
        },
        "blur": {
          "type": "Select",
          "config": {
            "label": "Effect: blur",
            "options": [
              "None",
              "Light",
              "Medium",
              "Heavy"
            ],
            "default_value": "None"
          }
        },
        "dim": {
          "type": "Select",
          "config": {
            "label": "Effect: dim (darkens on dark tiles, washes out on light tiles)",
            "options": [
              "None",
              "Light",
              "Medium",
              "Heavy"
            ],
            "default_value": "None"
          }
        },
        "color_effect": {
          "type": "Select",
          "config": {
            "label": "Effect: colour",
            "options": [
              "None",
              "Desaturate",
              "Black & white",
              "Warm",
              "Cool",
              "Vivid",
              "Faded"
            ],
            "default_value": "None"
          }
        },
        "vignette": {
          "type": "Boolean",
          "config": {
            "label": "Effect: vignette (darker edges)",
            "default_value": false
          }
        },
        "hover_zoom": {
          "type": "Boolean",
          "config": {
            "label": "Effect: zoom in slightly on hover",
            "default_value": false
          }
        },
        "slow_zoom": {
          "type": "Boolean",
          "config": {
            "label": "Effect: slow zoom (Ken Burns)",
            "default_value": false
          }
        },
        "image_brief": {
          "type": "Text",
          "config": {
            "label": "Photo brief (shown while the image is empty)",
            "placeholder": "e.g. Accordion Pedestal, front view, black backdrop, 4:3"
          }
        }
      }
    }
  ]
}
