{
  "id": "site_video",
  "type": "SharedSlice",
  "name": "SiteVideo",
  "description": "A Mux video in our own player, or a YouTube/Vimeo video loaded only when played (privacy friendly).",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow",
            "placeholder": "Small label above the title"
          }
        },
        "title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": ""
          }
        },
        "intro": {
          "type": "StructuredText",
          "config": {
            "label": "Intro",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "mux_video": {
          "type": "Text",
          "config": {
            "label": "Mux video (plays in our own player, wins over YouTube/Vimeo)",
            "placeholder": "https://stream.mux.com/….m3u8 or playback ID"
          }
        },
        "video": {
          "type": "Embed",
          "config": {
            "label": "YouTube or Vimeo URL"
          }
        },
        "without_sound": {
          "type": "Boolean",
          "config": {
            "label": "Play without sound (Mux only)",
            "default_value": false,
            "placeholder_false": "With sound",
            "placeholder_true": "Without sound"
          }
        },
        "caption": {
          "type": "Text",
          "config": {
            "label": "Caption",
            "placeholder": ""
          }
        },
        "poster": {
          "type": "Image",
          "config": {
            "label": "Poster image (optional)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "media_background": {
          "type": "Select",
          "config": {
            "label": "Media background",
            "options": [
              "Card",
              "Same as section"
            ],
            "default_value": "Card"
          }
        },
        "video_brief": {
          "type": "Text",
          "config": {
            "label": "Video brief (shown while no video is set)",
            "placeholder": ""
          }
        },
        "tone": {
          "type": "Select",
          "config": {
            "label": "Section tone",
            "options": [
              "Default",
              "Tinted",
              "Dark band"
            ],
            "default_value": "Default"
          }
        }
      },
      "items": {}
    }
  ]
}
