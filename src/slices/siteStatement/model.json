{
  "id": "site_statement",
  "type": "SharedSlice",
  "name": "SiteStatement",
  "description": "One big statement that lights up word by word as visitors scroll, with a short text under it.",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow",
            "placeholder": ""
          }
        },
        "statement": {
          "type": "Text",
          "config": {
            "label": "Statement",
            "placeholder": "Wrap words in *asterisks* to colour them"
          }
        },
        "caption": {
          "type": "StructuredText",
          "config": {
            "label": "Text under the statement",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "tone": {
          "type": "Select",
          "config": {
            "label": "Section tone",
            "options": [
              "Default",
              "Tinted",
              "Dark band"
            ],
            "default_value": "Default"
          }
        }
      },
      "items": {}
    }
  ]
}
