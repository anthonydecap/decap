{
  "id": "site_cta",
  "type": "SharedSlice",
  "name": "SiteCta",
  "description": "Closing call to action with optional price, two buttons and an image.",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow",
            "placeholder": ""
          }
        },
        "title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": ""
          }
        },
        "body": {
          "type": "StructuredText",
          "config": {
            "label": "Text",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "price": {
          "type": "Text",
          "config": {
            "label": "Price",
            "placeholder": "e.g. From € 4,950"
          }
        },
        "price_note": {
          "type": "Text",
          "config": {
            "label": "Price note",
            "placeholder": "excl. VAT, delivery on request"
          }
        },
        "primary_cta_label": {
          "type": "Text",
          "config": {
            "label": "Primary button label",
            "placeholder": ""
          }
        },
        "primary_cta_link": {
          "type": "Link",
          "config": {
            "label": "Primary button link",
            "allowTargetBlank": true,
            "select": null
          }
        },
        "secondary_cta_label": {
          "type": "Text",
          "config": {
            "label": "Secondary button label",
            "placeholder": ""
          }
        },
        "secondary_cta_link": {
          "type": "Link",
          "config": {
            "label": "Secondary button link",
            "allowTargetBlank": true,
            "select": null
          }
        },
        "image": {
          "type": "Image",
          "config": {
            "label": "Image (optional)",
            "constraint": {},
            "thumbnails": []
          }
        },
        "image_brief": {
          "type": "Text",
          "config": {
            "label": "Photo brief (shown while the image is empty)",
            "placeholder": "e.g. Accordion Pedestal, front view, black backdrop, 4:3"
          }
        },
        "tone": {
          "type": "Select",
          "config": {
            "label": "Section tone",
            "options": [
              "Default",
              "Tinted",
              "Dark band"
            ],
            "default_value": "Default"
          }
        }
      },
      "items": {}
    }
  ]
}
